{
  "name": "loylex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test && python3 -B -m unittest discover tests -p '*_test.py'",
    "format": "biome format --write .",
    "gateway": "bun src/gateway/main.ts",
    "import": "bun src/gateway/import.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "worker": "bun src/agent/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
