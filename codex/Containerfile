FROM node:24-bookworm-slim

ARG CODEX_VERSION=0.151.0

RUN npm install --global "@openai/codex@${CODEX_VERSION}" \
  && codex --version \
  && npm cache clean --force \
  && mkdir -p /codex-home /workspace \
  && chown -R node:node /codex-home /workspace

COPY --chmod=0755 entrypoint.sh /usr/local/bin/context-tg-codex

USER node
WORKDIR /workspace

ENV CODEX_HOME=/codex-home

ENTRYPOINT ["context-tg-codex"]
CMD ["app-server", "--listen", "ws://0.0.0.0:4500"]
